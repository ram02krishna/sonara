{
  "name": "sonara-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Sonara - Modern Music Streaming Web App (Spotify + Apple Music inspired)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "gen:api": "npm run gen --workspace=packages/api-spec"
  },
  "keywords": [
    "music",
    "streaming",
    "spotify",
    "apple-music",
    "nextjs",
    "golang",
    "monorepo"
  ],
  "author": "Sonara Engineering",
  "license": "MIT"
}
