# ==============================================================================
# Sonara production settings. Copy this file to `.env` ON THE EC2 SERVER
# (in the same folder as docker-compose.prod.yml) and fill it in:
#
#     cp .env.example .env && nano .env
#
# Rules: one KEY=value per line, no spaces around "=", no quotes, and avoid the
# characters  $ # " '  and spaces in values. `openssl rand -hex N` output is safe.
# NEVER commit the real .env.
# ==============================================================================

# --- Docker Hub ---------------------------------------------------------------
# Your Docker Hub username (e.g. ram02krishna)
DOCKERHUB_USERNAME=your_dockerhub_username

# --- Public API hostname & TLS ------------------------------------------------
# DNS: create an A record  DOMAIN -> the server's Elastic IP  BEFORE starting.
DOMAIN=api.example.com
# Let's Encrypt sends expiry warnings here
LETSENCRYPT_EMAIL=you@example.com

# --- Web app origin(s) --------------------------------------------------------
# Your Vercel URL / custom domain. Comma-separated, no trailing slash.
ALLOWED_ORIGINS=https://your-sonara-app.vercel.app

# --- Database (runs in Docker on this host; not exposed to the internet) -------
POSTGRES_USER=sonara
POSTGRES_DB=sonara
# generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- App secrets ----------------------------------------------------------------
# generate: openssl rand -hex 32
SESSION_SECRET=
# generate: openssl rand -hex 32   (64 hex characters)
TOKEN_ENCRYPTION_KEY=

# --- Music catalogue ------------------------------------------------------------
# https://developer.spotify.com/dashboard  (optional: without it search falls back to iTunes)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_DEFAULT_MARKET=IN
LRCLIB_API_URL=https://lrclib.net/api
# Optional: enables full songs in YouTube's official player
YOUTUBE_API_KEY=
