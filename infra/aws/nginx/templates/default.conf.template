# ==============================================================================
# Sonara API reverse proxy.
#
# This file is a *template*: the nginx image renders it into
# /etc/nginx/conf.d/default.conf at start-up, substituting only ${DOMAIN}.
# ==============================================================================

server_tokens off;

# Real client IP. The web app (Vercel) proxies requests to this server, so the TCP
# peer is Vercel, not the user. The API's login rate-limiter keys on client IP, and
# without this every user would share ONE bucket (20 logins/minute for the whole
# site). Take the left-most X-Forwarded-For entry, which is the original client.
map $http_x_forwarded_for $client_ip {
    "~^\s*(?<first_ip>[^,\s]+)"  $first_ip;
    default                      $remote_addr;
}

# ---------------------------------------------------------------- HTTP (port 80)
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Let's Encrypt HTTP-01 challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Liveness probe used by the container healthcheck / deploy script
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --------------------------------------------------------------- HTTPS (port 443)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options    "nosniff" always;

    client_max_body_size 2m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_proxied any;
    gzip_types application/json text/plain text/css application/javascript;

    # Resolve the `api` container through Docker's DNS at request time (not just at
    # start-up). nginx therefore keeps working when the API container is recreated
    # on deploy and gets a new IP, and it can start before the API is up.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://api:8080;

    proxy_http_version 1.1;
    proxy_set_header Connection         "";
    proxy_set_header Host               $host;
    proxy_set_header X-Real-IP          $client_ip;
    proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto  $scheme;
    proxy_connect_timeout 5s;
    proxy_send_timeout    35s;
    proxy_read_timeout    35s;   # a little above the API's own 30s request timeout

    location = /healthz {
        access_log off;
        proxy_pass $api_upstream;
    }

    location /api/ {
        proxy_pass $api_upstream;
    }

    location / {
        default_type application/json;
        return 404 '{"error":"not_found"}';
    }
}
