# ==============================================================================
# Sonara Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Application Environment (development | staging | production)
NODE_ENV=development
APP_ENV=development

# IMPORTANT: use 127.0.0.1 (not localhost) for BOTH the app and the API, and open the app at
# http://127.0.0.1:3000. Spotify requires the 127.0.0.1 loopback redirect, and the session
# cookie is only shared when the app and API use the same host.
# Web Frontend (apps/web)
PORT=3000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080/api/v1

# Backend API (apps/api)
API_PORT=8080
API_BASE_URL=http://127.0.0.1:8080
ALLOWED_ORIGINS=http://127.0.0.1:3000

# Security & Session Secrets (Generate strong 32+ character strings in production)
SESSION_SECRET=super-secret-sonara-session-encryption-key-32chars!
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# PostgreSQL Database
DATABASE_URL=postgres://sonara:sonarasecret@localhost:5432/sonara?sslmode=disable
POSTGRES_USER=sonara
POSTGRES_PASSWORD=sonarasecret
POSTGRES_DB=sonara
POSTGRES_PORT=5432

# Redis Cache & Sessions
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Spotify Developer App Credentials
# Create an app at https://developer.spotify.com/dashboard
# Ensure Web API and Web Playback SDK are checked
# Set Redirect URI to: http://127.0.0.1:8080/api/v1/auth/callback
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/v1/auth/callback
# Market used for logged-out catalog search (ISO-3166 alpha-2). Logged-in users use their own country.
SPOTIFY_DEFAULT_MARKET=IN
SPOTIFY_SCOPES=user-read-private user-read-email user-read-playback-state user-modify-playback-state user-read-currently-playing streaming user-read-recently-played user-top-read playlist-read-private playlist-modify-public playlist-modify-private user-library-read user-library-modify user-follow-read user-follow-modify

# Alternative Music Providers & APIs
LRCLIB_API_URL=https://lrclib.net/api
AUDIUS_APP_NAME=Sonara
JAMENDO_CLIENT_ID=
