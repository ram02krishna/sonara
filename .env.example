# ==============================================================================
# Sonara environment template. Copy to .env and adjust.
# ==============================================================================

APP_ENV=development
NODE_ENV=development

# --- Web (apps/web) ---------------------------------------------------------
PORT=3000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Where the Next.js server proxies /api/v1 to. The browser only ever talks to the
# web app's own origin, so the session cookie just works. (Baked in at build time;
# in Docker this is the api service on the compose network.)
API_INTERNAL_URL=http://127.0.0.1:8080/api/v1

# --- API (apps/api) ---------------------------------------------------------
API_PORT=8080
ALLOWED_ORIGINS=http://127.0.0.1:3000
# Set to true when Sonara is served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=false

# Generate strong random values in production
SESSION_SECRET=change-me-to-a-long-random-string-32chars!
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Data -------------------------------------------------------------------
DATABASE_URL=postgres://sonara:sonarasecret@localhost:5432/sonara?sslmode=disable
POSTGRES_USER=sonara
POSTGRES_PASSWORD=sonarasecret
POSTGRES_DB=sonara
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- Music catalogue --------------------------------------------------------
# Sonara uses Spotify ONLY as a catalogue (search, artists, albums, new releases)
# with your app's client credentials. Nobody logs in with Spotify.
# Create an app at https://developer.spotify.com/dashboard (no redirect URI needed).
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
# Region used until a listener picks their own (ISO-3166 alpha-2)
SPOTIFY_DEFAULT_MARKET=IN

# Lyrics (free, no key)
LRCLIB_API_URL=https://lrclib.net/api

# Optional: play FULL songs in YouTube's official, visible video player.
# Create a key for the "YouTube Data API v3" at https://console.cloud.google.com/
# Leave empty to use 30-second previews only.
YOUTUBE_API_KEY=
