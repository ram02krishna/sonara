# ==============================================================================
# Sonara Web (Next.js) - Environment Variables for Vercel Deployment
# ==============================================================================

# Public URL of your deployed Next.js web application
NEXT_PUBLIC_APP_URL=https://your-sonara-app.vercel.app

# URL of your deployed Go backend API.
# The Next.js server proxies /api/v1 to this URL, preserving session cookies.
# Examples:
#   API_INTERNAL_URL=https://api.yourdomain.com
#   API_INTERNAL_URL=https://sonara-api.up.railway.app
API_INTERNAL_URL=
